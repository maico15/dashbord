# Copy to .env and fill in values

# PostgreSQL (production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/dashboard

# SQLite (local dev — default when DATABASE_URL is not set)
# DATABASE_URL=sqlite:///./dashboard.db

ADMIN_PASSWORD=admin123

# SQLite DB path (local dev — ignored when DATABASE_URL is set)
DB_PATH=./dashboard.db

# Anthropic Admin API key for AI usage tracking (from console.anthropic.com/settings/keys)
ANTHROPIC_ADMIN_KEY=sk-ant-admin01-...

# GitHub personal/org token for PR sync
GITHUB_TOKEN=ghp_...

# Slack bot token for daily reports sync
SLACK_BOT_TOKEN=xoxb-...
