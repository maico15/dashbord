# Which backend the pages read and write. The page code never checks this —
# only src/data/index.js does. Flipping it is the whole cutover.
#
#   rest      — the FastAPI backend that runs today on Render (default)
#   supabase  — the Supabase project (needs the two keys below)
VITE_DATA_SOURCE=rest

# Необязательна. Без неё проект работает с нынешним бэкендом на Render —
# адрес зашит в src/api/client.js, чтобы после импорта в Lovable ничего не
# надо было настраивать. Задавать её нужно только чтобы указать на другой
# бэкенд, например поднятый локально:
# VITE_API_URL=http://localhost:8000

# Used when VITE_DATA_SOURCE=supabase. Lovable fills these in itself once the
# project is connected to Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
